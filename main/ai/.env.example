# ローカル開発用。モデル読込後、MQTT受信→Window→推論→結果MQTT配信を起動する。

# 現行モデルの固定前提。WINDOW_STEP=50 はローカル用の候補値。
WINDOW_SIZE=100
WINDOW_STEP=50
SAMPLING_RATE=50
INFERENCE_THRESHOLD=0.5

# ローカル単体起動用。Composeはhostをmqtt-brokerへ上書きする。
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=ccc-ai-input
MQTT_TLS=false
MQTT_CA_FILE=
MQTT_KEEPALIVE=60
MQTT_QOS=0
MQTT_USERNAME=
MQTT_PASSWORD=
DEVICE_API_URL=
DEVICE_API_TOKEN=
# 両方空ならDevice確認を省略したローカル推論。利用可否確認を有効化するにはHTTPS originと
# WebのDEVICE_API_TOKENと同じ32文字以上の乱数を設定する。URLに/apiは付けない。
MODEL_PATH=
SCALER_PATH=
MODEL_VERSION=
# 空欄ならartifacts/model_manifest.jsonのpath/versionを使用。
# 相対pathはmain/ai基準。別pathでもmanifestのSHA-256との一致を必須とする。
