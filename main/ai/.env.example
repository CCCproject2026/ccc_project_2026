# ローカル開発用。MQTT受信からバッチ検証までを起動する。

# 現行モデルの固定前提。WINDOW_STEP=50 はローカル用の候補値。
WINDOW_SIZE=100
WINDOW_STEP=50
SAMPLING_RATE=50
INFERENCE_THRESHOLD=0.5

# ローカル単体起動用。Composeはhostをmqtt-brokerへ上書きする。
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=ccc-ai-input
MQTT_TLS=false
MQTT_CA_FILE=
MQTT_KEEPALIVE=60
MQTT_QOS=0
MQTT_USERNAME=
MQTT_PASSWORD=
DEVICE_API_URL=
DEVICE_API_TOKEN=
MODEL_PATH=
SCALER_PATH=
MODEL_VERSION=
