# This file is used to set environment variables for the web application.
# Heroku Postgres direct URL (no pgbouncer). Session advisory lock requires a direct connection.
DATABASE_URL=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# 32-byte base64. Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STAFF_TOKEN_SECRET=

API_BASE_URL=/api

# このアプリの URL。招待メールのリンク先（/sign-up）に使う。Heroku では本番の URL を設定する
APP_URL=http://localhost:3000

# bootstrap:nurse (development only, never in production)
BOOTSTRAP_NURSE_EMAIL=
BOOTSTRAP_NURSE_PASSWORD=
BOOTSTRAP_NURSE_LAST_NAME=
BOOTSTRAP_NURSE_FIRST_NAME=
BOOTSTRAP_NURSE_DATE_OF_BIRTH=   # YYYY-MM-DD
BOOTSTRAP_NURSE_NATIONALITY=
BOOTSTRAP_NURSE_GENDER=          # 女性 or 男性
BOOTSTRAP_NURSE_START_DATE=      # YYYY-MM-DD
