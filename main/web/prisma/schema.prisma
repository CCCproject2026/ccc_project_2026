generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator erd {
  provider        = "prisma-erd-generator"
  output          = "./ERD.svg"
  puppeteerConfig = "./prisma/puppeteerConfig.json"
}

// 1. ユーザー管理（看護師・介護士）
// 新規のユーザーを作成する際に、ClerkのIDを保存する必要があります。ユーザーは、介護士、看護師、管理者のいずれかの役割を持つことができます。
// Admin や Nurse は user 登録ができるが、Caregiver は自分で登録できないようにする必要があります。
// user 登録時に admin や nuser が 登録する新規user の email 入力するとclerk に 一時的に招待メールが送信され、clerk の登録が完了すると、user 登録が完了するようにする必要があります。
// password は 招待メールのリンクから設定するようにする必要があります。
// Clerk側で一週間制限にする場合の、シンプルな設計
model User {
  id        String     @id @default(cuid())
  clerkId   String?    @unique // 招待中はNULL、登録完了したらClerkから同期する
  firstName String
  lastName  String
  email     String     @unique
  role      UserRole
  status    UserStatus @default(PENDING) // PENDING or ACTIVE
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

enum UserRole {
  CAREGIVER
  NURSE
  ADMIN
}
