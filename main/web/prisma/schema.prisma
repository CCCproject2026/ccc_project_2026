datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "./ERD.md"
}

// ==========================================
// 1. ユーザー管理（看護師・介護士・管理者）
// ==========================================
model User {
  id        String     @id @default(cuid())
  clerkId   String?    @unique // 招待中はNULL。Clerkでの登録完了後にWebhookで保存
  firstName String?
  lastName  String?
  email     String     @unique
  role      UserRole // CAREGIVER, NURSE, ADMIN
  status    UserStatus @default(PENDING) // 招待状態の管理（PENDING or ACTIVE）
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // リレーション：1人のスタッフ（User）は、多くの高齢者（Elder）を登録する
  createdElders Elder[] @relation("StaffCreatedElder")

  // リレーション：1人のスタッフ（User）は、多くの転倒アラームに対応して記録（FallLog）を書く
  handledLogs FallLog[] @relation("StaffHandledLog")
}

enum UserRole {
  CAREGIVER
  NURSE
  ADMIN
}

enum UserStatus {
  PENDING // 招待中（Clerk登録前）
  ACTIVE // 登録完了（システム利用可能）
}

// ==========================================
// 2. 高齢者管理（入所者）
// ==========================================
model Elder {
  id         String      @id @default(cuid())
  firstName  String
  lastName   String
  roomNumber String? // 駆けつけるための部屋番号
  status     ElderStatus @default(ACTIVE) // 死亡・退所時は INACTIVE にしてデータを残す
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // リレーション：この高齢者を登録したスタッフのID
  createdById String
  createdBy   User   @relation("StaffCreatedElder", fields: [createdById], references: [id])

  // リレーション：1人の高齢者は、付け替えの歴史の中で多くの「デバイス割当」を持つ
  deviceAssignments DeviceAssignment[]

  // リレーション：1人の高齢者は、何度も「転倒アラーム（FallLog）」が発生する可能性がある
  fallLogs FallLog[]
}

enum ElderStatus {
  ACTIVE // 在籍中
  INACTIVE // 逝去・退所（過去のデータ保存用）
}

// ==========================================
// 3. IoTデバイス・割当管理（使い回し対応）
// ==========================================
model Device {
  id         String   @id @default(cuid())
  deviceName String // 例: "センサーA-001"
  serialCode String // ハードウェアのシリアル番号
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // リレーション：1つのデバイスは、何度も違う人に割り当てられる
  assignments DeviceAssignment[]

  // リレーション：1つのデバイスは、何度も転倒アラーム（FallLog）を発信する
  fallLogs FallLog[]
}

model DeviceAssignment {
  id         String    @id @default(cuid())
  elderId    String
  deviceId   String
  is_active  Boolean   @default(true) // 現在この高齢者が使っているか（使い回しを可能にする核心）
  assignedAt DateTime  @default(now())
  removedAt  DateTime? // 付け替え（回収）した日時

  // 各テーブルとのリレーション
  elder  Elder  @relation(fields: [elderId], references: [id])
  device Device @relation(fields: [deviceId], references: [id])
}

// ==========================================
// 4. 転倒ログ・対応履歴（専門テーブル）
// ==========================================
model FallLog {
  id           String    @id @default(cuid())
  elderId      String // 誰が倒れたか
  deviceId     String // どのデバイスが検知したか
  staffId      String? // 誰が対応して確認したか（アラーム発生時はNULL）
  alarmTime    DateTime  @default(now()) // アラーム発生時刻
  responseTime DateTime? // スタッフが「確認ボタン」を押した時刻
  isActualFall Boolean? // ★本当の転倒かどうか（true: 本当に転倒, false: 誤検知, NULL: 未確認）
  notes        String? // スタッフの状況記入メモ

  // 各テーブルとのリレーション
  elder  Elder  @relation(fields: [elderId], references: [id])
  device Device @relation(fields: [deviceId], references: [id])
  staff  User?  @relation("StaffHandledLog", fields: [staffId], references: [id])
}
