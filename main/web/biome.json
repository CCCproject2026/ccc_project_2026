{
	"$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
	"files": {
	  "ignore": [
		".next/**",
		"node_modules/**",
		"dist/**"
	  ]
	},
	"formatter": {
	  "enabled": true,
	  "indentStyle": "tab",
	  "lineEnding": "lf",
	  "lineWidth": 100
	},
	"linter": {
	  "enabled": true,
	  "rules": {
		"recommended": true
	  }
	},
	"organizeImports": {
	  "enabled": true
	},
	"javascript": {
	  "formatter": {
		"quoteStyle": "single",
		"semicolons": "always"
	  }
	}
  }