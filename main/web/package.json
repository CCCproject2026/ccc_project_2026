{
	"name": "elderly-fall-prevention-web",
	"private": true,
	"packageManager": "pnpm@9.15.0",
	"scripts": {
		"dev": "next dev",
		"prisma:migrate": "prisma migrate dev",
		"prisma:deploy": "prisma migrate deploy",
		"prisma:status": "prisma migrate status",
		"prisma:push": "prisma db push",
		"prisma:generate": "prisma generate --generator client",
		"prisma:erd": "prisma generate --generator erd",
		"prisma:seed": "prisma db seed",
		"prisma:studio": "prisma studio",
		"prisma:validate": "prisma validate",
		"build": "prisma generate --generator client && next build",
		"start": "next start",
		"bootstrap:nurse": "tsx --require ./scripts/allow-server-only.cjs scripts/bootstrap-nurse.ts",
		"staff:reconcile-cancelled": "tsx --require ./scripts/allow-server-only.cjs scripts/reconcile-cancelled-invitations.ts",
		"staff:reconcile-deleted": "tsx --require ./scripts/allow-server-only.cjs scripts/reconcile-deleted-clerk-users.ts",
		"lint": "eslint src",
		"biome:check": "biome check",
		"biome:write": "biome check --write"
	},
	"dependencies": {
		"@clerk/nextjs": "^7.5.10",
		"@heroicons/react": "^2.2.0",
		"@hookform/resolvers": "^5.9.1",
		"@prisma/client": "^6.19.3",
		"@tailwindcss/postcss": "^4.3.1",
		"@tanstack/react-query": "^5.104.1",
		"@tanstack/react-query-devtools": "^5.104.1",
		"dotenv": "^16.6.1",
		"lucide-react": "^1.21.0",
		"next": "^15.3.3",
		"pg": "^8.23.1",
		"prisma": "^6.19.3",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-hook-form": "^7.87.0",
		"react-icons": "^5.7.0",
		"server-only": "^0.0.1",
		"svix": "^2.8.0",
		"tailwindcss": "^4.3.1",
		"tsx": "^4.19.3",
		"zod": "^4.5.4"
	},
