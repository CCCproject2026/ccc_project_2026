		"@prisma/config": "^6.19.3",
		"@types/node": "^22.15.30",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"eslint": "^9.39.4",
		"eslint-config-next": "^16.2.7",
		"prisma-erd-generator": "^2.4.3",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.3"
