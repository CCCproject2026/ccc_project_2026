{
  "openapi": "3.0.3",
  "info": {
    "title": "AI Device Lookup API",
    "version": "1.0.0",
    "description": "Implemented route contract; deployment URL not yet configured. No Elder or assignment data."
  },
  "paths": {
    "/api/devices/by-code/{deviceCode}": {
      "get": {
        "operationId": "lookupDeviceByCode",
        "security": [
          {
            "deviceToken": []
          }
        ],
        "parameters": [
          {
            "name": "deviceCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            "description": "Case-sensitive. Authenticated invalid or missing code returns 404."
          }
        ],
        "responses": {
          "200": {
            "description": "Device administrative status",
            "headers": {
              "Cache-Control": {
                "description": "Always no-store",
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Device"
                },
                "examples": {
                  "active": {
                    "value": {
                      "device_code": "ESP32-001",
                      "status": "ACTIVE"
                    }
                  },
                  "inactive": {
                    "value": {
                      "device_code": "ESP32-001",
                      "status": "INACTIVE"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer token",
            "headers": {
              "Cache-Control": {
                "description": "Always no-store",
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Reserved for future service scope restrictions",
            "headers": {
              "Cache-Control": {
                "description": "Always no-store",
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Authenticated lookup: invalid code or device not found",
            "headers": {
              "Cache-Control": {
                "description": "Always no-store",
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          },
          "429": {
            "description": "Rate limiting by infrastructure; no body schema required",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "headers": {
              "Cache-Control": {
                "description": "Always no-store",
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable",
            "headers": {
              "Cache-Control": {
                "description": "Always no-store",
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "deviceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated read-only token; never exposed to browsers."
      }
    },
    "schemas": {
      "Device": {
        "type": "object",
        "required": [
          "device_code",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "device_code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE",
              "MAINTENANCE"
            ],
            "description": "MAINTENANCE is reserved for the planned Web enum extension; normalized to INACTIVE by AI."
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "NotFound": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "NOT_FOUND"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
